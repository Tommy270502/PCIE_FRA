*.jou
*.log
*.str
*.pb
*.rpt
*.rpx
*.wdb
*.wcfg
dfx_runtime.txt
dfx_runtime_*.txt

hardware/**/.Xil/
hardware/**/*.cache/
hardware/**/*.gen/
hardware/**/*.hw/
hardware/**/*.ip_user_files/
hardware/**/*.runs/
hardware/**/*.sim/
hardware/**/fra_zynq7015_pcie.srcs/utils_1/

# Bitstreams, checkpoints and hardware handoff files are release artifacts.
*.bit
*.dcp
*.mcs
*.xsa
hardware/fra_zynq7015_pcie/export/
hardware/fra_zynq7015_pcie/scripts/.xsim/

# xsim leftovers from running a testbench in place
xsim.dir/
*.wdb
*.vcd
webtalk*.jou

# --- Vitis / firmware -----------------------------------------------------
# Vitis writes CMake+Ninja trees, compile databases and IDE state that all carry
# absolute paths from the machine that generated them. The BSP *sources* are
# checked in; everything the BSP build produces is not. See software/README.md.
software/**/build_configs/
software/**/build/
software/**/export/
software/**/logs/
software/**/lib/*.a
software/**/_ide/
software/.rigel_lopper/
software/**/.cache/
software/**/compile_commands.json
software/**/.clangd
software/**/*.elf
software/**/*.map
software/**/*.o
software/**/*.d
software/**/*.a
software/**/*.pdi
software/**/*.vitisWorkspace.json

# Boot image and its .bif. build_boot_image.sh regenerates the .bif on every run
# because it has to carry absolute paths.
software/boot.bif
software/BOOT.BIN

# --- Host tools -----------------------------------------------------------
software/host/fra_cli
software/host/fra_bar_test
# Calibration written at runtime; valid only for the sweep setup it was taken
# with, so it is local state, not a checked-in baseline.
software/host/fra_cal.csv

