# AX7015B PCIe FRA endpoint (Xilinx vendor 0x10ee, device 0x7021).
#
# Two things are needed for the host tools in software/host/ to reach BAR0
# without root:
#
#  1. VFIO character devices readable by the FRA_GROUP group. This is the route
#     that works when Secure Boot has put the kernel into lockdown, which
#     blocks mmap() of /sys/bus/pci/.../resource0 for every process, root
#     included.
#  2. As a fallback on machines with lockdown off, memory decode enabled and
#     resource0 group-accessible.
#
# Install with: sudo software/host/scripts/fra-pcie-setup.sh

SUBSYSTEM=="vfio", GROUP="plugdev", MODE="0660"
KERNEL=="vfio", GROUP="plugdev", MODE="0666"

ACTION=="add|change", SUBSYSTEM=="pci", ATTR{vendor}=="0x10ee", ATTR{device}=="0x7021", \
    ATTR{enable}="1", \
    RUN+="/bin/sh -c 'chgrp plugdev /sys/bus/pci/devices/$kernel/resource0 2>/dev/null; chmod 0660 /sys/bus/pci/devices/$kernel/resource0 2>/dev/null'"
