# AX7015B PCIe FRA endpoint (Xilinx vendor 0x10ee, device 0x7021).
#
# Permissions only. Driver binding is handled by modprobe.d/fra-pcie.conf
# (vfio-pci ids=), not from here: binding a driver inside a udev RUN rule is
# unreliable, because udev holds a lock on the device while RUN executes and the
# bind generates further uevents.
#
# Install with: sudo software/host/scripts/fra-pcie-setup.sh

# VFIO nodes readable by the group. The per-group node (/dev/vfio/<iommu group>)
# is created when vfio-pci claims the device, so this must cover new nodes.
SUBSYSTEM=="vfio", GROUP="plugdev", MODE="0660"
KERNEL=="vfio", GROUP="plugdev", MODE="0666"

# Memory decode on, plus sysfs-fallback permissions for hosts where kernel
# lockdown is off and the plain resource0 mmap still works.
ACTION=="add|change", SUBSYSTEM=="pci", ATTR{vendor}=="0x10ee", ATTR{device}=="0x7021", \
    ATTR{enable}="1", \
    RUN+="/bin/sh -c 'chgrp plugdev /sys/bus/pci/devices/$kernel/resource0 2>/dev/null; chmod 0660 /sys/bus/pci/devices/$kernel/resource0 2>/dev/null'"
